# pack: ${pack_name} ${pack_version}
# pinned: ${pinned_name} ${pinned_version} (tool-list ${tool_list_hash})
# reviewed: ${reviewed} by ${reviewed_by}
# params: owner=${owner}, repos=${repos}, approver=${approver}
name: github-agent
mode: dry-run          # flip to enforce when the WOULD-DENY log looks right
default: deny

mcp:
  enforce:
    # GitHub MCP tools take the account (owner) and the repository name (repo)
    # as separate arguments. Both are checked on every governed call.

    # reads: your repos only
    get_file_contents:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    list_issues:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    issue_read:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    list_pull_requests:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    pull_request_read:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    list_commits:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    get_commit:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    list_branches:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"

    # writes: allowed, your repos only
    issue_write:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    add_issue_comment:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    update_pull_request:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
    create_pull_request:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
        base: "oneof:main,develop"

    # high blast radius: a human signs each call
    merge_pull_request:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"
    push_files:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"
    create_or_update_file:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"
    delete_file:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"
    create_branch:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"
    update_pull_request_branch:
      args:
        owner: "exact:${owner}"
        repo: "pattern:${repos}"
      approval:
        threshold: 1
        approver: "${approver}"

# Everything else is denied by default: search_* (free-text queries can't be
# scoped to a repo), fork_repository, create_repository and any tool not listed
# above. The explicit list keeps the reviewer's intent visible.
deny:
  - fork_repository
  - create_repository
